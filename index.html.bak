        <style>
          /* ---- Org Chart Styles ---- */
          .org-chart { display:flex; flex-direction:column; align-items:center; }
          .org-chart .org-level { display:flex; justify-content:center; gap:24px; position:relative; }

          /* Garis vertikal dari bawah parent ke garis horizontal anak */
          .org-chart .org-v-line {
            width:2px; height:36px; background:#198754; margin:0 auto;
          }
          .org-chart .org-v-line.teal { background:#20c997; }

          /* Wrapper grup anak: membuat garis horizontal + cabang turun */
          .org-chart .org-children {
            display:flex; justify-content:center; gap:24px;
            position:relative; padding-top:36px;
          }
          /* Garis horizontal di atas setiap grup anak */
          .org-chart .org-children::before {
            content:'';
            position:absolute; top:0;
            left:calc(50% - (var(--branch-w) / 2));
            width:var(--branch-w);
            height:2px; background:#198754;
          }
          .org-chart .org-children.teal::before { background:#20c997; }

          /* Garis vertikal turun dari garis horizontal ke setiap kartu anak */
          .org-chart .org-children > .org-child {
            display:flex; flex-direction:column; align-items:center;
            position:relative; padding-top:0;
          }
          .org-chart .org-children > .org-child::before {
            content:'';
            position:absolute; top:-36px; left:50%; transform:translateX(-50%);
            width:2px; height:36px; background:#198754;
          }
          .org-chart .org-children.teal > .org-child::before { background:#20c997; }

          /* Kartu */
          .org-card {
            width:190px; border-radius:16px;
            border:0; box-shadow:0 2px 12px rgba(0,0,0,.09);
            background:#fff; padding:16px 12px; text-align:center;
          }
          .org-card .org-icon {
            width:56px; height:56px; border-radius:50%;
            display:flex; align-items:center; justify-content:center;
            margin:0 auto 10px;
          }
          .org-card h6 { font-weight:700; margin-bottom:4px; font-size:.9rem; }
          .org-card p  { font-size:.72rem; color:#6c757d; margin:0; }

          /* Mobile: semua jadi list vertikal dengan garis kiri */
          @media(max-width:767px){
            .org-card { width:100%; }
            .org-chart .org-children { flex-direction:column; gap:0; padding-top:0; --branch-w:0px !important; }
            .org-chart .org-children::before { display:none; }
            .org-chart .org-children > .org-child { padding-top:0; padding-left:20px; border-left:2px solid #198754; margin-left:20px; }
            .org-chart .org-children.teal > .org-child { border-left-color:#20c997; }
            .org-chart .org-children > .org-child::before { display:none; }
            .org-chart .org-v-line { margin-left:20px; }
            .org-chart .org-level { flex-direction:column; align-items:flex-start; gap:0; }
          }
        </style>

